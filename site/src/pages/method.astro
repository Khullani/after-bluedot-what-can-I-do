---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry, render } from 'astro:content';

const entry = await getEntry('pages', 'playbook');
if (!entry) throw new Error('playbook page entry not found');
const { Content } = await render(entry);
---

<BaseLayout title="The Method" description="The long version. The framing, the menu, and the appendix on staying grounded.">
  <Content />
</BaseLayout>
