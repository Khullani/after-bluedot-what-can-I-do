---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry, render } from 'astro:content';

const entry = await getEntry('pages', 'FAQ');
if (!entry) throw new Error('FAQ page entry not found');
const { Content } = await render(entry);
---

<BaseLayout title="FAQ" description="Short answers to the questions cohort members and facilitators ask most.">
  <Content />
</BaseLayout>
